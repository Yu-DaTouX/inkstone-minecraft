{
  "name": "inkstone-minecraft",
  "version": "0.1.0",
  "description": "Inkstone Minecraft：Minecraft Java 版启动器",
  "author": "Yu-DaTouX",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --experimental-strip-types --no-warnings scripts/test-core.ts",
    "test:install": "node --experimental-strip-types --no-warnings scripts/test-install.ts",
    "test:forge": "node --experimental-strip-types --no-warnings scripts/test-forge.ts",
    "test:mods": "node --experimental-strip-types --no-warnings scripts/test-mods.ts",
    "test:crash": "node --experimental-strip-types --no-warnings scripts/test-crash.ts",
    "test:version": "node --experimental-strip-types --no-warnings scripts/test-version-ops.ts",
    "test:service": "node --experimental-strip-types --no-warnings scripts/test-service.ts",
    "test:download": "node --experimental-strip-types --no-warnings scripts/test-download.ts",
    "test:all": "npm test && npm run test:install && npm run test:forge && npm run test:mods && npm run test:crash && npm run test:version && npm run test:service && npm run test:download"
  },
  "dependencies": {
    "@xmcl/core": "2.16.2",
    "@xmcl/unzip": "2.1.2",
    "@xmcl/user": "4.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.9.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.57.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "overrides": {
    "@xmcl/unzip": "2.1.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
